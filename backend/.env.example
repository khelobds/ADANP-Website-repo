DB_HOST=localhost
DB_NAME=adanp_portal
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Frontend origins allowed to call the API with the session cookie (comma-separated, exact match)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Session cookie. Use SESSION_SAMESITE=None and SESSION_SECURE=true (HTTPS only)
# when the frontend and API are on different sites.
SESSION_SAMESITE=Lax
# SESSION_SECURE=true   (defaults to true automatically when the request is HTTPS)
SESSION_IDLE_TIMEOUT=7200

# Login rate limit: failures allowed per email+IP and per IP within the window (seconds)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=900
