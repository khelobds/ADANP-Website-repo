# Example Nginx server block for the ADANP API. Nginx ignores .htaccess files, so this repeats
# the rules from backend/public/uploads/.htaccess and backend/public/api/uploads/.htaccess.
# Adjust server_name, root, the PHP-FPM socket and the TLS settings for the real host.

server {
    listen 80;
    server_name api.example.org;

    # Document root is backend/public, so config/, database/, bin/, storage/ stay unreachable
    root /var/www/adanp/backend/public;
    index index.php;

    # Gallery uploads: serve known media types only, never run anything as PHP
    location ^~ /api/uploads/ {
        location ~* \.(jpe?g|png|gif|mp4|webm|pdf)$ {
            add_header X-Content-Type-Options nosniff;
            try_files $uri =404;
        }
        return 404;
    }

    # Old public folder for proof-of-payment files. Proofs now live in backend/storage/proofs
    # and are served to admins by api/proof.php, so nothing here is served.
    location ^~ /uploads/ {
        return 404;
    }

    # Hidden files such as .htaccess and .env
    location ~ /\. {
        return 404;
    }

    # PHP endpoints. Because the upload locations above use ^~, this block never sees them.
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;

        # Settings read with getenv() (see backend/.env.example)
        # fastcgi_param DB_HOST localhost;
        # fastcgi_param CORS_ALLOWED_ORIGINS https://www.example.org;
    }

    # Behind a load balancer or proxy, pass the real client IP so the login rate limit
    # (config/RateLimit.php uses REMOTE_ADDR) counts visitors, not the proxy:
    # set_real_ip_from 10.0.0.0/8;
    # real_ip_header X-Forwarded-For;
}
