# Old public location for proof-of-payment files. Proofs are now stored in storage/proofs/
# and served to admins by api/proof.php, so nothing here is served directly.
Require all denied

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
