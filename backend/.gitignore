.env
/vendor/

# User uploads (gallery media, proof-of-payment files, old public proofs); keep only the folder markers and their .htaccess
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess
/public/api/uploads/*
!/public/api/uploads/.gitkeep
!/public/api/uploads/.htaccess
/storage/proofs/*
!/storage/proofs/.gitkeep
/storage/cpd/*
!/storage/cpd/.gitkeep
